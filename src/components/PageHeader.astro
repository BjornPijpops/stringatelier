---
import Section from './Section.astro';

interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<Section tone="soft" compact>
  <h1 class="text-3xl sm:text-5xl">{title}</h1>
  {intro && <p class="mt-4 max-w-3xl text-lg text-ink-soft">{intro}</p>}
</Section>
