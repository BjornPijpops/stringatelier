---
import Section from './Section.astro';

interface Props {
  title: string;
  /**
   * Intro text. Inline content only: it renders inside a `<p>`, so no block elements.
   * For markup (e.g. bold) use the `intro` slot instead; the slot wins when both are given.
   */
  intro?: string;
}

const { title, intro } = Astro.props;
const hasIntroSlot = Astro.slots.has('intro');
---

<Section tone="soft" compact>
  <h1 class="text-3xl sm:text-5xl">{title}</h1>
  {(intro || hasIntroSlot) && (
    <p class="mt-4 text-lg text-pretty text-ink-soft">
      {hasIntroSlot ? <slot name="intro" /> : intro}
    </p>
  )}
</Section>
