---
import Container from './Container.astro';
import { siteName, siteTagline } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto bg-ink text-white">
  <Container class="flex flex-col gap-1 py-8 text-sm sm:flex-row sm:justify-between">
    <p class="font-display tracking-tight uppercase">{siteName}</p>
    <p class="text-white/70">{siteTagline}</p>
    <p class="text-white/70">
      &copy; {year} {siteName}
    </p>
  </Container>
</footer>
