---
import Container from './Container.astro';
import { navItems, siteName } from '../data/site';
import { withBase } from '../lib/withBase';

const year = new Date().getFullYear();
const linkClass =
  'inline-flex min-h-11 min-w-11 items-center underline decoration-white/40 underline-offset-4 hover:decoration-white';
---

<footer class="bg-ink text-white">
  <Container class="flex flex-col gap-2 py-4 text-sm sm:flex-row sm:items-center sm:justify-between">
    <p class="text-white/80">
      <span class="font-display tracking-tight text-white uppercase">
        {siteName}
      </span>
      {` · © ${year}`}
    </p>
    <nav aria-label="Voetnavigatie">
      <ul class="flex flex-wrap gap-x-4">
        {navItems.map((item) => (
          <li>
            <a class={linkClass} href={withBase(item.href)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</footer>
