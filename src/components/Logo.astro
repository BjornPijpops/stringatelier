---
import { Image } from 'astro:assets';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Drop `logo.svg`, `logo.png` or `logo.webp` into src/assets and it is used automatically.
const logos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/logo.{svg,png,webp}',
  { eager: true },
);
const logo = Object.values(logos)[0]?.default;
---

{logo && (
  <Image
    src={logo}
    alt=""
    loading="lazy"
    decoding="async"
    class:list={['w-auto', className]}
  />
)}
