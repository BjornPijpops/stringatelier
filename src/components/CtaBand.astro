---
import Section from './Section.astro';
import ButtonLink from './ButtonLink.astro';

interface Props {
  heading: string;
  text: string;
  href: string;
  label: string;
}

const { heading, text, href, label } = Astro.props;
const headingId = `cta-${href.replace(/\W+/g, '-')}`;
---

<Section tone="brand" aria-labelledby={headingId}>
  <h2 id={headingId} class="text-xl text-white sm:text-2xl">
    {heading}
  </h2>
  <p class="mt-3 max-w-3xl text-brand-soft">{text}</p>
  <ButtonLink href={href} variant="inverse" class="mt-6">
    {label}
  </ButtonLink>
</Section>
