---
import ColourLabel from './ColourLabel.astro';
import type { PriceGroup } from '../lib/familyPricing';
import { formatMoney } from '../lib/formatMoney';

interface Props {
  groups: PriceGroup[];
}

const { groups } = Astro.props;
const [first] = groups;
---

{groups.length === 1 && first ? (
  <div>
    <p class="flex flex-wrap items-baseline gap-x-2">
      <span class="font-display text-3xl text-brand tabular-nums">
        {formatMoney(first.totalCents)}
      </span>
      <span class="text-sm text-ink-soft">per racket</span>
    </p>
    <p class="mt-1 text-sm text-ink-soft">
      <ColourLabel colours={first.colours} />
    </p>
  </div>
) : (
  <div>
    <ul class="space-y-1">
      {groups.map((group) => (
        <li class="flex items-baseline justify-between gap-2 text-sm">
          <ColourLabel colours={group.colours} />
          <span class="text-right font-display text-xl text-brand tabular-nums">
            <span class="sr-only">per racket </span>
            {formatMoney(group.totalCents)}
          </span>
        </li>
      ))}
    </ul>
    <p class="mt-1 text-sm text-ink-soft">per racket, kleur naar keuze</p>
  </div>
)}
