---
import ColourDot from './ColourDot.astro';
import type { PriceGroup } from '../lib/familyPricing';
import { formatMoney } from '../lib/formatMoney';

interface Props {
  groups: PriceGroup[];
}

const { groups } = Astro.props;
const [single] = groups;
const isSingle = groups.length === 1;
---

{isSingle && single && (
  <div>
    <p class="flex flex-wrap items-baseline gap-x-2">
      <span class="font-display text-3xl text-brand tabular-nums">{formatMoney(single.totalCents)}</span>
      <span class="text-sm text-ink-soft">per racket</span>
    </p>
    <p class="mt-1 flex items-center gap-2 text-sm text-ink-soft">
      <span class="flex gap-1">
        {single.colours.map((colour) => <ColourDot {colour} />)}
      </span>
      {single.colours.join(', ')}
    </p>
  </div>
)}

{!isSingle && (
  <div>
    <ul class="space-y-1">
      {groups.map((group) => (
        <li class="flex items-baseline justify-between gap-2">
          <span class="flex items-center gap-2 text-sm">
            <span class="flex gap-1">
              {group.colours.map((colour) => <ColourDot {colour} />)}
            </span>
            {group.colours.join(', ')}
          </span>
          <span class="text-right font-display text-xl text-brand tabular-nums">
            <span class="sr-only">per racket </span>{formatMoney(group.totalCents)}
          </span>
        </li>
      ))}
    </ul>
    <p class="mt-1 text-sm text-ink-soft">per racket, kleur naar keuze</p>
  </div>
)}
