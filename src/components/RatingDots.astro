---
interface Props {
  label: string;
  value: 1 | 2 | 3 | 4 | 5;
  max?: number;
}

const { label, value, max = 5 } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
  <span class="text-sm font-semibold">{label}</span>
  <span class="flex items-center gap-1">
    <span class="sr-only">
      {value} van {max}
    </span>
    {Array.from({ length: max }, (_, i) => (
      <span
        aria-hidden="true"
        class={`size-3 rounded-full ${i < value ? 'bg-brand' : 'bg-brand-soft'}`}
      />
    ))}
  </span>
</div>
