---
import Container from './Container.astro';
import { navItems, siteName } from '../data/site';
import { withBase } from '../lib/withBase';

const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const isCurrent = (href: string) =>
  withBase(href).replace(/\/+$/, '') === currentPath;
---

<header class="border-b border-line bg-surface">
  <Container class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
    <a
      href={withBase('/')}
      class="flex min-h-11 items-center font-display text-xl tracking-tight text-brand-strong uppercase"
    >
      String<span class="rounded bg-brand px-1.5 text-white">Atelier</span>
      <span class="sr-only">{siteName} home</span>
    </a>
    <nav aria-label="Hoofdnavigatie">
      <ul class="flex gap-4 text-sm font-semibold sm:gap-6">
        {navItems.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="flex min-h-11 items-center border-b-2 border-transparent px-1 hover:border-brand aria-[current=page]:border-brand"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</header>
