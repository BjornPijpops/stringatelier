---
import { servicePriceCents, stringOptions } from '../data/pricing';
import { formatMoney } from '../lib/formatMoney';
import { OWN_STRING_NAME, OWN_STRING_VALUE } from '../lib/calculatorConfig';

const rows = [
  {
    id: OWN_STRING_VALUE,
    name: OWN_STRING_NAME,
    price: `${formatMoney(servicePriceCents)} per racket · alleen service`,
  },
  ...stringOptions.map((option) => ({
    id: option.id,
    name: option.name,
    price: `${formatMoney(servicePriceCents + option.priceCents)} per racket`,
  })),
];

const stepButton =
  'grid size-11 shrink-0 place-items-center rounded-lg bg-white text-2xl font-bold text-brand hover:bg-brand-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:opacity-40 disabled:hover:bg-white';
---

<section
  id="calculator"
  class="hidden rounded-2xl bg-brand p-4 text-white sm:p-8"
  aria-labelledby="calculator-heading"
>
  <h2 id="calculator-heading" class="text-xl text-white">
    Bereken je prijs
  </h2>
  <p class="mt-1 text-sm text-brand-soft">
    Tik op + bij de snaar(en) die je wilt. Combineren kan.
  </p>
  <ul class="mt-3 divide-y divide-white/20" id="calc-rows">
    {rows.map((row) => (
      <li
        role="group"
        aria-label={row.name}
        class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2"
        data-row
        data-id={row.id}
      >
        <div class="min-w-24 flex-1">
          <p class="font-semibold leading-tight">{row.name}</p>
          <p class="text-sm tabular-nums text-brand-soft">{row.price}</p>
        </div>
        <button
          type="button"
          class={stepButton}
          data-step="-1"
          aria-label={`Eén ${row.name} minder`}
          disabled
        >
          &minus;
        </button>
        <output
          class="w-8 text-center text-lg font-bold tabular-nums text-white/60"
          data-quantity
        >
          0
        </output>
        <button
          type="button"
          class={stepButton}
          data-step="1"
          aria-label={`Eén ${row.name} meer`}
        >
          +
        </button>
      </li>
    ))}
  </ul>

  <div class="mt-4 border-t border-white/30 pt-3">
    <div id="calc-empty">
      <p class="font-semibold">Kies hierboven je snaar en aantal.</p>
      <p class="mt-1 text-sm text-brand-soft">
        Eigen snaar? Dan betaal je enkel {formatMoney(servicePriceCents)} per
        racket.
      </p>
    </div>
    <div id="calc-summary" hidden>
      <ul
        id="calc-breakdown"
        class="mb-2 grid gap-1 text-sm text-brand-soft"
        hidden
      ></ul>
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="font-semibold">Totaal</p>
          <p id="calc-count" class="text-sm text-brand-soft"></p>
        </div>
        <p
          id="calc-total"
          class="font-display text-4xl tabular-nums"
          aria-live="polite"
        ></p>
      </div>
    </div>
  </div>
</section>
<script>
  import { formatMoney } from '../lib/formatMoney';
  import { servicePriceCents, stringOptions } from '../data/pricing';
  import { MAX_QUANTITY } from '../lib/calculatorConfig';
  import {
    stepQuantity,
    summarizeOrder,
    type Selection,
  } from '../lib/orderSummary';

  const pricing = { servicePriceCents, stringOptions };
  const root = document.querySelector<HTMLElement>('#calculator');

  if (root) {
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-row]'));
    const empty = root.querySelector<HTMLElement>('#calc-empty')!;
    const summary = root.querySelector<HTMLElement>('#calc-summary')!;
    const breakdown = root.querySelector<HTMLElement>('#calc-breakdown')!;
    const count = root.querySelector<HTMLElement>('#calc-count')!;
    const total = root.querySelector<HTMLElement>('#calc-total')!;

    const quantityOf = (row: HTMLElement) =>
      Number(row.querySelector('[data-quantity]')!.textContent);

    function setQuantity(row: HTMLElement, quantity: number) {
      const output = row.querySelector<HTMLElement>('[data-quantity]')!;
      output.textContent = String(quantity);
      output.classList.toggle('text-white/60', quantity === 0);
      row.classList.toggle('bg-white/10', quantity > 0);
      row.querySelector<HTMLButtonElement>('[data-step="-1"]')!.disabled =
        quantity === 0;
      row.querySelector<HTMLButtonElement>('[data-step="1"]')!.disabled =
        quantity === MAX_QUANTITY;
    }

    function render() {
      const selections: Selection[] = rows.map((row) => ({
        id: row.dataset.id!,
        name: row.getAttribute('aria-label')!,
        quantity: quantityOf(row),
      }));
      const order = summarizeOrder(selections, pricing);

      empty.hidden = order !== null;
      summary.hidden = order === null;
      if (!order) return;

      breakdown.hidden = order.rows.length < 2;
      breakdown.replaceChildren(
        ...order.rows.map((row) => {
          const item = document.createElement('li');
          item.className = 'flex justify-between gap-4';
          const amount = document.createElement('span');
          amount.className = 'tabular-nums';
          amount.textContent = formatMoney(row.totalCents);
          item.append(row.label, amount);
          return item;
        }),
      );
      const unit = order.racketCount === 1 ? 'racket' : 'rackets';
      count.textContent = `${order.racketCount} ${unit}`;
      total.textContent = formatMoney(order.totalCents);
    }

    // Hidden without JavaScript: the noscript price list stays the source of truth.
    root.classList.remove('hidden');
    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-step]',
      );
      const row = button?.closest<HTMLElement>('[data-row]');
      if (!button || !row) return;
      const step = Number(button.dataset.step);
      setQuantity(row, stepQuantity(quantityOf(row), step));
      render();
    });
    render();
  }
</script>
