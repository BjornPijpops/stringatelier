---
import { servicePriceCents, stringFamilies } from '../data/pricing';
import { formatMoney } from '../lib/formatMoney';
import { MAX_QUANTITY, OWN_STRING_VALUE } from '../lib/calculatorConfig';

const stepButton =
  'grid size-11 shrink-0 place-items-center rounded-lg bg-white text-2xl font-bold text-brand hover:bg-brand-soft';
const lightButton =
  'inline-flex min-h-11 items-center justify-center rounded-full px-5 font-semibold';
---

<section
  id="calculator"
  class="hidden rounded-2xl bg-brand p-6 text-white sm:p-8"
  aria-labelledby="calculator-heading"
>
  <h2 id="calculator-heading" class="text-xl text-white">
    Bereken je prijs
  </h2>
  <p class="mt-2 text-sm text-brand-soft">
    Combineer gerust verschillende snaren: voeg per soort snaar een regel toe.
  </p>
  <form class="mt-5 grid gap-5" novalidate>
    <div id="calc-lines" class="grid gap-5"></div>
    <button
      type="button"
      id="calc-add"
      class={`${lightButton} border-2 border-white text-white hover:bg-white/10`}
    >
      + Andere snaar toevoegen
    </button>
  </form>
  <div class="mt-6 border-t border-white/30 pt-5">
    <div
      class="text-sm text-brand-soft"
      id="calc-breakdown"
      aria-live="polite"
    ></div>
    <p
      class="mt-3 font-display text-5xl text-white"
      id="calc-total"
      aria-live="polite"
    ></p>
  </div>

  <template id="calc-line-template">
    <fieldset
      class="grid gap-3 rounded-xl border border-white/30 p-4"
      data-line
    >
      <legend class="px-2 text-sm font-semibold" data-legend></legend>
      <div>
        <label class="block text-sm font-semibold" data-string-label>
          Snaar
        </label>
        <select
          name="string"
          class="mt-1 min-h-11 w-full rounded-lg border border-white bg-white px-3 py-2 text-base text-ink"
          data-string
        >
          <option value={OWN_STRING_VALUE}>Eigen snaar (alleen service)</option>
          {stringFamilies.map((family) => (
            <optgroup label={family.name}>
              {family.variants.map((variant) => (
                <option value={variant.id}>
                  {family.name} {variant.colour} ·{' '}
                  {formatMoney(servicePriceCents + variant.priceCents)}
                </option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold" data-quantity-label>
          Aantal rackets
        </label>
        <div class="mt-1 flex gap-2">
          <button
            type="button"
            class={stepButton}
            data-step="-1"
            aria-label="Eén racket minder"
          >
            &minus;
          </button>
          <input
            name="quantity"
            type="number"
            min="1"
            max={MAX_QUANTITY}
            step="1"
            value="1"
            inputmode="numeric"
            class="min-h-11 w-full min-w-0 rounded-lg border border-white bg-white px-3 py-2 text-center text-base text-ink [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
            data-quantity
          />
          <button
            type="button"
            class={stepButton}
            data-step="1"
            aria-label="Eén racket meer"
          >
            +
          </button>
        </div>
      </div>
      <button
        type="button"
        class={`${lightButton} justify-self-start bg-white text-brand hover:bg-brand-soft`}
        data-remove
        hidden
      >
        Verwijder deze regel
      </button>
    </fieldset>
  </template>
</section>
<script>
  import { calculateOrder } from '../lib/calculateTotal';
  import { formatMoney } from '../lib/formatMoney';
  import {
    servicePriceCents,
    stringOptions,
    type Cents,
  } from '../data/pricing';
  import { MAX_QUANTITY, OWN_STRING_VALUE } from '../lib/calculatorConfig';

  const root = document.querySelector<HTMLElement>('#calculator');
  const linesContainer = root?.querySelector<HTMLElement>('#calc-lines');
  const template = root?.querySelector<HTMLTemplateElement>(
    '#calc-line-template',
  );
  const addButton = root?.querySelector<HTMLButtonElement>('#calc-add');
  const breakdown = root?.querySelector<HTMLElement>('#calc-breakdown');
  const total = root?.querySelector<HTMLElement>('#calc-total');

  const OWN_STRING_NAME = 'eigen snaar';
  const stringNames = new Map(
    stringOptions.map((option) => [option.id, option.name]),
  );
  let lineCounter = 0;

  function parseQuantity(raw: string): number | null {
    const value = Number(raw);
    return Number.isInteger(value) && value >= 1 && value <= MAX_QUANTITY
      ? value
      : null;
  }

  function getLines(): HTMLElement[] {
    return Array.from(
      linesContainer?.querySelectorAll<HTMLElement>('[data-line]') ?? [],
    );
  }

  function readLine(line: HTMLElement) {
    const select = line.querySelector<HTMLSelectElement>('[data-string]')!;
    const input = line.querySelector<HTMLInputElement>('[data-quantity]')!;
    const stringId = select.value === OWN_STRING_VALUE ? null : select.value;
    return { stringId, quantity: parseQuantity(input.value) };
  }

  /** Keeps legends, label links and remove buttons in sync after lines are added or removed. */
  function refreshLines() {
    const lines = getLines();
    lines.forEach((line, index) => {
      const number = index + 1;
      line.querySelector('[data-legend]')!.textContent = `Regel ${number}`;
      line
        .querySelector<HTMLButtonElement>('[data-remove]')!
        .toggleAttribute('hidden', lines.length === 1);
    });
  }

  function addLine() {
    if (!template || !linesContainer) return;
    const line = (template.content.cloneNode(true) as DocumentFragment)
      .firstElementChild as HTMLElement;
    const id = ++lineCounter;
    const pairs: [string, string][] = [
      ['[data-string]', 'data-string-label'],
      ['[data-quantity]', 'data-quantity-label'],
    ];
    pairs.forEach(([fieldSelector, labelAttribute]) => {
      const field = line.querySelector<HTMLElement>(fieldSelector)!;
      field.id = `calc-${fieldSelector.slice(6, -1)}-${id}`;
      line
        .querySelector<HTMLLabelElement>(`[${labelAttribute}]`)!
        .setAttribute('for', field.id);
    });
    linesContainer.append(line);
    refreshLines();
  }

  function describeLine(stringId: string | null, quantity: number): string {
    const name =
      stringId === null ? OWN_STRING_NAME : (stringNames.get(stringId) ?? '');
    return `${quantity} × ${name}`;
  }

  function renderBreakdown(
    requests: { stringId: string | null; quantity: number }[],
    lineTotals: readonly Cents[],
  ) {
    const list = document.createElement('ul');
    list.className = 'grid gap-1';
    requests.forEach((request, index) => {
      const item = document.createElement('li');
      item.className = 'flex justify-between gap-4';
      const label = document.createElement('span');
      label.textContent = describeLine(request.stringId, request.quantity);
      const amount = document.createElement('span');
      amount.className = 'tabular-nums';
      amount.textContent = formatMoney(lineTotals[index]);
      item.append(label, amount);
      list.append(item);
    });
    breakdown!.replaceChildren(list);
  }

  function render() {
    if (!breakdown || !total) return;

    const parsed = getLines().map(readLine);
    const requests = parsed.flatMap((line) =>
      line.quantity === null
        ? []
        : [{ stringId: line.stringId, quantity: line.quantity }],
    );
    if (requests.length !== parsed.length) {
      breakdown.textContent = `Vul bij elke regel een aantal in tussen 1 en ${MAX_QUANTITY}.`;
      total.textContent = '';
      return;
    }

    const order = calculateOrder(requests, {
      servicePriceCents,
      stringOptions,
    });
    renderBreakdown(
      requests,
      order.lines.map((line) => line.totalCents),
    );
    total.textContent = formatMoney(order.totalCents);
  }

  if (root && linesContainer) {
    // Hidden without JavaScript: the price cards stay the source of truth.
    root.classList.remove('hidden');
    root.addEventListener('input', render);
    addButton?.addEventListener('click', () => {
      addLine();
      render();
    });
    linesContainer.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const line = target.closest<HTMLElement>('[data-line]');
      if (!line) return;

      const stepButton = target.closest<HTMLElement>('[data-step]');
      if (stepButton) {
        const input = line.querySelector<HTMLInputElement>('[data-quantity]')!;
        const next =
          (parseQuantity(input.value) ?? 1) + Number(stepButton.dataset.step);
        input.value = String(Math.min(MAX_QUANTITY, Math.max(1, next)));
      } else if (target.closest('[data-remove]')) {
        line.remove();
        refreshLines();
      } else {
        return;
      }
      render();
    });
    addLine();
    render();
  }
</script>
