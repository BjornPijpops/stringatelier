---
import { formatMoney } from '../lib/formatMoney';
import type { StringOption } from '../data/pricing';

interface Props {
  options: readonly StringOption[];
}

const { options } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-line">
  <table class="w-full text-left">
    <caption class="sr-only">Prijzen per type snaar</caption>
    <thead class="bg-brand text-sm text-white">
      <tr>
        <th scope="col" class="px-4 py-3 font-semibold">
          Snaar
        </th>
        <th scope="col" class="px-4 py-3 text-right font-semibold">
          Prijs
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      {options.map((option) => (
        <tr class="odd:bg-surface-alt">
          <th scope="row" class="px-4 py-3 font-semibold">
            {option.name}
          </th>
          <td class="px-4 py-3 text-right tabular-nums">
            {formatMoney(option.priceCents)}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
