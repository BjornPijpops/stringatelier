---
import RatingDots from './RatingDots.astro';
import type { StringFamily } from '../data/pricing';

interface Props {
  family: StringFamily;
}

const { family } = Astro.props;
const colours = family.variants.map((variant) => variant.colour).join(' of ');
const labelClass = 'text-sm font-bold tracking-wider text-brand uppercase';
---

<!-- On wide screens the card spans the 5 shared grid rows so rows line up across cards. -->
<article class="grid min-w-0 grid-cols-1 gap-y-4 rounded-2xl border border-line bg-surface p-5 md:row-span-5 md:grid-rows-subgrid">
  <div>
    <h3 class="text-lg">{family.name}</h3>
    <p class="mt-1 font-semibold">{family.tagline}</p>
  </div>

  <div class="space-y-2">
    <RatingDots label="Kracht" value={family.ratings.power} />
    <RatingDots label="Controle" value={family.ratings.control} />
    <RatingDots label="Duurzaamheid" value={family.ratings.durability} />
  </div>

  <dl class="space-y-3 border-t border-line pt-4">
    <div>
      <dt class={labelClass}>Gevoel</dt>
      <dd class="mt-0.5">{family.feel}</dd>
    </div>
    <div>
      <dt class={labelClass}>Dikte</dt>
      <dd class="mt-0.5">{family.gauge}</dd>
    </div>
  </dl>

  <p class="rounded-lg bg-surface-alt px-3 py-2 text-sm">
    <span class="font-semibold">Ideaal voor:</span> {family.bestFor}
  </p>

  <p class="text-sm text-ink-soft">Kleur: {colours}</p>
</article>
