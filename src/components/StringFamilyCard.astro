---
import { formatMoney } from '../lib/formatMoney';
import type { Cents, StringFamily } from '../data/pricing';

interface Props {
  family: StringFamily;
  servicePriceCents: Cents;
}

const { family, servicePriceCents } = Astro.props;

/** Swatch colours for the string colours we sell. Unknown colours get no swatch. */
const swatches: Record<string, string> = {
  wit: 'bg-white border-ink-soft',
  zwart: 'bg-ink border-ink',
};
---

<article class="flex flex-col rounded-2xl border border-line bg-surface p-5 transition hover:border-brand hover:shadow-md">
  <h3 class="text-lg">{family.name}</h3>

  <details class="mt-1">
    <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 text-sm font-semibold text-brand [&::-webkit-details-marker]:hidden">
      <span
        aria-hidden="true"
        class="grid size-6 place-items-center rounded-full bg-brand text-xs font-bold text-white"
      >
        ?
      </span>
      Wat is {family.name}?
    </summary>
    <p class="pb-2 text-ink-soft">{family.summary}</p>
  </details>

  <ul class="mt-2 divide-y divide-line border-t border-line">
    {family.variants.map((variant) => (
      <li class="flex items-center justify-between gap-3 py-3">
        <span class="flex items-center gap-2 font-semibold capitalize">
          {swatches[variant.colour] && (
            <span
              aria-hidden="true"
              class={`size-4 shrink-0 rounded-full border ${swatches[variant.colour]}`}
            />
          )}
          {variant.colour}
        </span>
        <span class="text-right">
          <span class="block font-display text-xl text-brand tabular-nums">
            {formatMoney(servicePriceCents + variant.priceCents)}
          </span>
          <span class="block text-sm text-ink-soft tabular-nums">
            {formatMoney(servicePriceCents)} + {formatMoney(variant.priceCents)}
          </span>
        </span>
      </li>
    ))}
  </ul>
</article>
