---
import RatingDots from './RatingDots.astro';
import type { StringFamily } from '../data/pricing';

interface Props {
  family: StringFamily;
}

const { family } = Astro.props;
const colours = family.variants.map((variant) => variant.colour).join(' of ');
---

<article class="flex flex-col rounded-2xl border border-line bg-surface p-5">
  <h3 class="text-lg">{family.name}</h3>
  <p class="mt-1 font-semibold">{family.tagline}</p>

  <div class="mt-4 space-y-2">
    <RatingDots label="Kracht" value={family.ratings.power} />
    <RatingDots label="Controle" value={family.ratings.control} />
    <RatingDots label="Duurzaamheid" value={family.ratings.durability} />
  </div>

  <dl class="mt-4 space-y-3 border-t border-line pt-4 text-sm">
    <div>
      <dt class="text-ink-soft">Gevoel</dt>
      <dd>{family.feel}</dd>
    </div>
    <div>
      <dt class="text-ink-soft">Geluid</dt>
      <dd>{family.sound}</dd>
    </div>
    <div>
      <dt class="text-ink-soft">Dikte</dt>
      <dd>{family.gauge}</dd>
    </div>
  </dl>

  <p class="mt-4 rounded-lg bg-surface-alt px-3 py-2 text-sm">
    <span class="font-semibold">Ideaal voor:</span> {family.bestFor}
  </p>
  <p class="mt-3 text-sm text-ink-soft">Kleur: {colours}</p>
</article>
