---
import { directionsUrl, osmEmbedUrl } from '../lib/mapLinks';
import type { Coordinates } from '../lib/mapLinks';

interface Props {
  venue: string;
  address: string;
  coordinates: Coordinates;
}

const { venue, address, coordinates } = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-line bg-surface">
  <div
    data-map-frame
    class="grid h-64 place-items-center bg-brand-soft p-4 sm:h-80"
    data-src={osmEmbedUrl(coordinates)}
    data-title={`Kaart van ${venue}`}
  >
    <button
      type="button"
      data-map-load
      class="inline-flex min-h-11 items-center rounded-full bg-brand px-6 font-semibold text-white hover:bg-brand-strong"
    >
      Toon kaart
    </button>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 p-4">
    <p>
      <span class="font-semibold">{venue}</span>
      <br />
      <span class="text-ink-soft">{address}</span>
    </p>
    <a
      class="inline-flex min-h-11 items-center rounded-full border-2 border-brand px-5 font-semibold text-brand hover:bg-brand-soft"
      href={directionsUrl(address)}
      target="_blank"
      rel="noopener noreferrer"
    >
      Route openen
    </a>
  </div>
</div>

<script>
  // The map loads on demand: no third-party requests until the visitor asks for it.
  document
    .querySelectorAll<HTMLElement>('[data-map-frame]')
    .forEach((frame) => {
      const button = frame.querySelector<HTMLButtonElement>('[data-map-load]');
      button?.addEventListener('click', () => {
        if (!frame.dataset.src) return;
        const iframe = document.createElement('iframe');
        iframe.src = frame.dataset.src;
        iframe.title = frame.dataset.title ?? 'Kaart';
        iframe.loading = 'lazy';
        iframe.className = 'h-full w-full border-0';
        frame.replaceChildren(iframe);
        frame.classList.remove('grid', 'place-items-center', 'p-4');
      });
    });
</script>
