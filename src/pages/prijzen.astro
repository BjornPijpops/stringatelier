---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import PriceCalculator from '../components/PriceCalculator.astro';
import StringFamilyCard from '../components/StringFamilyCard.astro';
import { formatWholeEuros } from '../lib/formatMoney';
import { withBase } from '../lib/withBase';
import { servicePriceCents, stringFamilies } from '../data/pricing';
---

<BaseLayout
  title="Prijzen"
  description="Bekijk de prijzen voor het besnaren van je badmintonracket: €12 per racket, plus de snaar naar keuze."
>
  <PageHeader title="Prijzen">
    <Fragment slot="intro">
      Besnaren kost{' '}
      <strong class="text-brand">{formatWholeEuros(servicePriceCents)}</strong>
      per racket, plus de snaar die je kiest. Eigen snaar? Dan betaal je alleen
      die {formatWholeEuros(servicePriceCents)}.
    </Fragment>
  </PageHeader>

  <Section aria-labelledby="strings-heading">
    <h2 id="strings-heading" class="text-xl">
      Welke snaar past bij jou?
    </h2>
    <p class="mt-3 mb-6 text-pretty text-ink-soft">
      Drie snaren, drie karakters. Twijfel je? BG-65 is de veilige keuze:
      comfortabel en lang bruikbaar. Prijzen zijn per racket, besnaren
      inclusief.
    </p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {stringFamilies.map((family) => (
        <StringFamilyCard {family} />
      ))}
    </div>
  </Section>

  <Section tone="soft" aria-label="Rekenhulp">
    <PriceCalculator />
  </Section>

  <CtaBand
    heading="Klaar om te besnaren?"
    text="Breng je racket mee naar de training in Sporthal Herkules, of stuur ons eerst een berichtje."
    href={withBase('/contact')}
    label="Contact en afgifte"
  />
</BaseLayout>
