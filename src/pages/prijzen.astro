---
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceTable from '../components/PriceTable.astro';
import PriceCalculator from '../components/PriceCalculator.astro';
import { formatMoney } from '../lib/formatMoney';
import { servicePriceCents, stringOptions } from '../data/pricing';
---

<BaseLayout
  title="Prijzen"
  description="Bekijk de prijzen voor het besnaren van je badmintonracket: €12 per racket, plus de snaar naar keuze."
>
  <h1 class="text-3xl sm:text-5xl">Prijzen</h1>

  <section
    class="mt-10 rounded-2xl bg-surface-alt p-6 sm:p-8"
    aria-labelledby="service-heading"
  >
    <h2 id="service-heading" class="text-xl">
      Besnaren
    </h2>
    <p class="mt-3 flex flex-wrap items-baseline gap-x-3 font-display text-4xl text-brand">
      <span>{formatMoney(servicePriceCents)}</span>
      <span class="text-base text-ink-soft">per racket</span>
    </p>
    <p class="mt-4 max-w-xl text-ink-soft">
      Dit is het tarief voor onze service. De snaar komt daar bovenop, tenzij je
      je eigen snaar meebrengt: dan betaal je alleen de servicekosten.
    </p>
  </section>

  <section class="mt-10" aria-labelledby="strings-heading">
    <h2 id="strings-heading" class="text-xl">
      Snaren
    </h2>
    <p class="mt-3 mb-5 max-w-xl text-ink-soft">
      Prijs per snaar, bovenop de servicekosten per racket.
    </p>
    <PriceTable options={stringOptions} />
  </section>

  <PriceCalculator />
</BaseLayout>
