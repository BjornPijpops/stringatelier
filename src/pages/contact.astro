---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import LocationMap from '../components/LocationMap.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { contactEmail, contactPeople, handover } from '../data/contact';
import { formatBelgianPhone, toTelHref, toWhatsAppHref } from '../lib/phone';

const linkClass =
  'inline-flex min-h-11 max-w-full items-center font-semibold wrap-anywhere underline text-brand decoration-brand-soft decoration-2 underline-offset-4';
---

<BaseLayout
  title="Contact"
  description="Neem contact op met StringAtelier in Herk-de-Stad voor het besnaren van je badmintonracket."
>
  <PageHeader
    title="Contact"
    intro="Vragen over besnaren of een racket afgeven? Neem gerust contact op."
  />

  <Section>
    <div class="grid gap-6 sm:grid-cols-2">
      <section
        class="rounded-2xl bg-surface-alt p-6"
        aria-labelledby="reach-heading"
      >
        <h2 id="reach-heading" class="text-xl">
          Bereik ons
        </h2>
        <ul class="mt-4 grid gap-4">
          {contactPeople.map((person) => (
            <li class="border-t border-line pt-4 first:border-t-0 first:pt-0">
              <h3 class="text-lg font-bold text-ink">{person.name}</h3>
              <p class="text-ink-soft tabular-nums">
                {formatBelgianPhone(person.phone)}
              </p>
              <div class="mt-3 grid grid-cols-2 gap-3">
                <ButtonLink
                  href={toTelHref(person.phone)}
                  class="w-full"
                  aria-label={`Bel ${person.name}`}
                >
                  Bel
                </ButtonLink>
                <ButtonLink
                  href={toWhatsAppHref(person.phone)}
                  variant="secondary"
                  external
                  class="w-full"
                  aria-label={`WhatsApp ${person.name}`}
                >
                  WhatsApp
                </ButtonLink>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-4 border-t border-line pt-4 text-sm text-ink-soft">
          <span class="block">E-mail</span>
          <a class={`${linkClass} flex`} href={`mailto:${contactEmail}`}>
            {contactEmail}
          </a>
        </p>
      </section>

      <section
        class="rounded-2xl bg-surface-alt p-6"
        aria-labelledby="handover-heading"
      >
        <h2 id="handover-heading" class="text-xl">
          Afgeven en ophalen
        </h2>
        <p class="mt-4 text-ink-soft">{handover.description}</p>
        <ul class="mt-4 divide-y divide-line">
          {handover.slots.map((slot) => (
            <li class="flex justify-between py-2">
              <span class="font-semibold">{slot.day}</span>
              <span class="tabular-nums">{slot.time}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Section>

  <Section tone="soft" aria-labelledby="map-heading">
    <h2 id="map-heading" class="mb-4 text-xl">
      Waar vind je ons?
    </h2>
    <LocationMap
      venue={handover.venue}
      address={handover.address}
      coordinates={handover.coordinates}
    />
  </Section>
</BaseLayout>
